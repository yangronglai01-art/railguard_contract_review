APP_NAME=RailGuard AI
APP_ENV=development
APP_VERSION=0.1.0

# 风险分析模式：mock、openai或deepseek。
# mock使用确定性规则；其他模式使用对应供应商的模型Agent。
MODEL_PROVIDER=mock

# 当前模式使用的模型名称。
# mock示例：mock-contract-reviewer
# DeepSeek示例：deepseek-v4-pro
MODEL_NAME=mock-contract-reviewer

# MODEL_PROVIDER=openai时填写对应API密钥。
OPENAI_API_KEY=

# OpenAI兼容接口地址；留空时使用SDK默认地址。
OPENAI_BASE_URL=

# MODEL_PROVIDER=deepseek时填写对应API密钥。
DEEPSEEK_API_KEY=

# DeepSeek官方Responses API地址，也可以配置企业网关。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次模型调用超时，单位为秒。
MODEL_TIMEOUT_SECONDS=120

# 临时故障的最大重试次数。
MODEL_MAX_RETRIES=2

# 系统提示词、合同和证据的最大总字符数。
MODEL_MAX_INPUT_CHARS=120000

# RAG运行模式及外部服务连接配置。
RAG_MODE=mock
RAG_BASE_URL=http://localhost:8001
RAG_API_KEY=
RAG_TIMEOUT_SECONDS=10

# 本地演示知识库路径。
RAG_MOCK_CORPUS_PATH=data/demo/rag-corpus-baus-v1.json

# 合同业务数据库路径。
DATABASE_PATH=data/runtime/railguard.db

# LangGraph审核状态数据库路径。
CHECKPOINT_PATH=data/runtime/review-checkpoints.sqlite3

# Streamlit前端访问FastAPI的地址。
RAILGUARD_API_BASE_URL=http://127.0.0.1:8000

# Docker映射到宿主机的服务端口。
RAILGUARD_API_PORT=8000
RAILGUARD_UI_PORT=8501

# Docker容器访问宿主机外部RAG服务时使用的地址。
DOCKER_RAG_BASE_URL=http://host.docker.internal:8001